DATABASE_URL="mysql://user:password@localhost:3306/aipic"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-min-32-chars"

ENCRYPTION_KEY="your-encryption-key-32-chars-here"

OPENAI_API_KEY="sk-..."

NEXT_PUBLIC_API_URL="http://localhost:3000"

# Service-to-service auth for /api/generate (e.g. the Book Robot Factory).
# When set, a request with `Authorization: Bearer <AIPIC_SERVICE_TOKEN>` runs as
# the owner below and uses that owner's stored OpenAI key. Leave unset to disable.
AIPIC_SERVICE_TOKEN=""
AIPIC_SERVICE_USER_EMAIL=""
